{
  "title": "外門",
  "chapter": "第一章：盤庫",
  "start": "s1_n1",
  "nodes": {
    "s1_n1": {
      "id": "s1_n1",
      "text": "晨鐘剛歇。你在內門青石道上掃落葉，掃帚聲被靴跟蓋過去。內門弟子成群走過，沒人低頭。",
      "background": "青石道",
      "sprite": "none",
      "scene": "青石道",
      "goto": "s1_n2",
      "type": "line"
    },
    "s1_n2": {
      "id": "s1_n2",
      "text": "同門阿禾把水桶頓在你腳邊，聲音壓得很低。",
      "sprite": "ahe",
      "goto": "s1_n3",
      "type": "line"
    },
    "s1_n3": {
      "id": "s1_n3",
      "text": "今天盤庫。陳執法親自來。你昨天幫謝師兄送進庫房的那箱東西，最好從你腦子裡拿掉。",
      "speaker": "阿禾",
      "goto": "s1_n4",
      "type": "line"
    },
    "s1_n4": {
      "id": "s1_n4",
      "text": "謝承淵的功勞，從來不是他自己立的。",
      "speaker": "阿禾",
      "goto": "s1_n5",
      "type": "line"
    },
    "s1_n5": {
      "id": "s1_n5",
      "text": "水還在晃。他沒把桶遞給你，像是怕手一伸，話也跟著出去。",
      "goto": "s1_ch",
      "type": "line"
    },
    "s1_ch": {
      "id": "s1_ch",
      "choices": [
        {
          "text": "那箱是什麼？",
          "setFlags": {
            "curiosity": 1,
            "he_confides": 1,
            "xie_watch": "+1"
          },
          "goto": "s2_conf_1"
        },
        {
          "text": "我沒看見。",
          "setFlags": {
            "willful_blind": 1,
            "he_trust": "-1",
            "safe": "+1"
          },
          "goto": "s2_blind_1"
        },
        {
          "text": "你知道就該少說。",
          "setFlags": {
            "he_fear": 1,
            "climb_lean": 1,
            "he_trust": "-2"
          },
          "goto": "s2_fear_1"
        }
      ],
      "scene": "青石道",
      "type": "choice"
    },
    "s2_conf_1": {
      "id": "s2_conf_1",
      "text": "阿禾喉結動了一下。左右掃過，才把聲音再壓低半寸。",
      "scene": "赴庫",
      "goto": "s2_conf_2",
      "type": "line"
    },
    "s2_conf_2": {
      "id": "s2_conf_2",
      "text": "黃耆。冊上寫黃耆。",
      "speaker": "阿禾",
      "goto": "s2_conf_3",
      "type": "line"
    },
    "s2_conf_3": {
      "id": "s2_conf_3",
      "text": "箱比尋常藥箱沉，封條是內門的。謝師兄昨天午後把你叫去，不是隨便差遣。",
      "speaker": "阿禾",
      "goto": "s2_conf_4",
      "type": "line"
    },
    "s2_conf_4": {
      "id": "s2_conf_4",
      "text": "你還沒接話，他先搖頭。",
      "goto": "s2_conf_5",
      "type": "line"
    },
    "s2_conf_5": {
      "id": "s2_conf_5",
      "text": "別問我開沒開。我沒那個膽。我只告訴你——陳執法點名的時候，你別搶著出聲，也別裝傻裝過頭。",
      "speaker": "阿禾",
      "goto": "s2_conf_6",
      "type": "line"
    },
    "s2_conf_6": {
      "id": "s2_conf_6",
      "text": "他提起水桶，朝庫房方向偏了下巴。",
      "goto": "s2_conf_7",
      "type": "line"
    },
    "s2_conf_7": {
      "id": "s2_conf_7",
      "text": "走。遲到的，先記過。",
      "speaker": "阿禾",
      "goto": "s2_conf_8",
      "type": "line"
    },
    "s2_conf_8": {
      "id": "s2_conf_8",
      "text": "你們並肩走了十幾步。他忽然補了一句，像是把剩下的半句硬嚥回去又吐出來：",
      "goto": "s2_conf_9",
      "type": "line"
    },
    "s2_conf_9": {
      "id": "s2_conf_9",
      "text": "劉三上個月也幫人搬過箱子。後來名冊上沒他了。",
      "speaker": "阿禾",
      "goto": "s2_yard_1",
      "type": "line"
    },
    "s2_blind_1": {
      "id": "s2_blind_1",
      "text": "阿禾盯著你，嘴角扯了一下，不是笑。",
      "scene": "赴庫",
      "goto": "s2_blind_2",
      "type": "line"
    },
    "s2_blind_2": {
      "id": "s2_blind_2",
      "text": "行。你沒看見。",
      "speaker": "阿禾",
      "goto": "s2_blind_3",
      "type": "line"
    },
    "s2_blind_3": {
      "id": "s2_blind_3",
      "text": "他把水桶提回去，水濺上你鞋面。",
      "goto": "s2_blind_4",
      "type": "line"
    },
    "s2_blind_4": {
      "id": "s2_blind_4",
      "text": "最好真沒看見。陳執法不聽嘴，聽冊。冊上沒你的名字，你就還能掃地。",
      "speaker": "阿禾",
      "goto": "s2_blind_5",
      "type": "line"
    },
    "s2_blind_5": {
      "id": "s2_blind_5",
      "text": "他先走了兩步，又停。背影僵著。",
      "goto": "s2_blind_6",
      "type": "line"
    },
    "s2_blind_6": {
      "id": "s2_blind_6",
      "text": "……別跟別人學我這樣講話。我今天腦子進水。",
      "speaker": "阿禾",
      "goto": "s2_blind_7",
      "type": "line"
    },
    "s2_blind_7": {
      "id": "s2_blind_7",
      "text": "夾道裡只剩掃帚靠牆的聲音。你跟上去。他不再回頭，可步伐比平時慢半拍，像是在等你，又像是在確認你真的把話咽了。",
      "goto": "s2_yard_1",
      "type": "line"
    },
    "s2_fear_1": {
      "id": "s2_fear_1",
      "text": "阿禾臉上的血色退得很快。他點頭，點得很乾脆，像門規寫好的那種。",
      "scene": "赴庫",
      "goto": "s2_fear_2",
      "type": "line"
    },
    "s2_fear_2": {
      "id": "s2_fear_2",
      "text": "是。我多嘴。",
      "speaker": "阿禾",
      "goto": "s2_fear_3",
      "type": "line"
    },
    "s2_fear_3": {
      "id": "s2_fear_3",
      "text": "水桶撞上他小腿，他沒罵。只把袖口裡那點剛才還要說的話，一起揉進去。",
      "goto": "s2_fear_4",
      "type": "line"
    },
    "s2_fear_4": {
      "id": "s2_fear_4",
      "text": "謝師兄看得遠。你跟他走，比跟我說話強。",
      "speaker": "阿禾",
      "goto": "s2_fear_5",
      "type": "line"
    },
    "s2_fear_5": {
      "id": "s2_fear_5",
      "text": "他這句說得很平，平得像詛咒。",
      "goto": "s2_fear_6",
      "type": "line"
    },
    "s2_fear_6": {
      "id": "s2_fear_6",
      "text": "盤庫的時候，各人顧各人。",
      "speaker": "阿禾",
      "goto": "s2_fear_7",
      "type": "line"
    },
    "s2_fear_7": {
      "id": "s2_fear_7",
      "text": "他加快腳步，把你甩在夾道轉角後。你聽見他在前面對守庫的外門弟子乾笑了一聲，像從來沒跟你說過話。",
      "goto": "s2_yard_1",
      "type": "line"
    },
    "s2_yard_1": {
      "id": "s2_yard_1",
      "text": "庫房外坪。木門半開，藥香更重。外門弟子已蹲成兩列，等人點冊。",
      "background": "庫房外坪",
      "sprite": "ahe",
      "scene": "庫房外坪",
      "goto": "s2_yard_2",
      "type": "line"
    },
    "s2_yard_2": {
      "id": "s2_yard_2",
      "text": "庫房門楣上掛著青衡宗的舊匾，漆剝了一角。執法堂的人在門內擺桌，墨已研好。沒有人交頭接耳。有人咳，立刻被旁邊的肘撞回去。",
      "goto": "s2_yard_3",
      "type": "line"
    },
    "s2_yard_3": {
      "id": "s2_yard_3",
      "text": "你在末列站定。阿禾在你斜前方——近得能看見他後頸的汗，遠得像隔了一道門規。",
      "goto": [
        {
          "if": {
            "he_confides": 1
          },
          "to": "s2_yard_conf"
        },
        {
          "if": {
            "willful_blind": 1
          },
          "to": "s2_yard_blind"
        },
        {
          "if": {
            "he_fear": 1
          },
          "to": "s2_yard_fear"
        },
        {
          "to": "s3_1"
        }
      ],
      "type": "line"
    },
    "s2_yard_conf": {
      "id": "s2_yard_conf",
      "text": "他沒回頭，可手指在身側屈了兩下，像在數箱子。",
      "goto": "s3_1",
      "type": "line"
    },
    "s2_yard_blind": {
      "id": "s2_yard_blind",
      "text": "他當你不存在。這比罵你乾淨。",
      "goto": "s3_1",
      "type": "line"
    },
    "s2_yard_fear": {
      "id": "s2_yard_fear",
      "text": "他換了位子，站到另一列去了。",
      "goto": "s3_1",
      "type": "line"
    },
    "s3_1": {
      "id": "s3_1",
      "text": "陳執法進門的時候，沒人聽見靴聲。是冊子先落在案上，一下，兩下。",
      "background": "庫房",
      "sprite": "chen",
      "scene": "盤庫",
      "goto": "s3_2",
      "type": "line"
    },
    "s3_2": {
      "id": "s3_2",
      "text": "外門庫，秋盤。",
      "speaker": "陳肅",
      "goto": "s3_3",
      "type": "line"
    },
    "s3_3": {
      "id": "s3_3",
      "text": "點名。應到者出列，不應到者除。",
      "speaker": "陳肅",
      "goto": "s3_4",
      "type": "line"
    },
    "s3_4": {
      "id": "s3_4",
      "text": "他叫的是職，不是人。管鑰的、管秤的、管簽的，一個個出去，報數，核印。你站在雜役列裡，連「應到」都不算，只算「在場」。",
      "goto": "s3_5",
      "type": "line"
    },
    "s3_5": {
      "id": "s3_5",
      "text": "點到黃耆。",
      "goto": "s3_6",
      "type": "line"
    },
    "s3_6": {
      "id": "s3_6",
      "text": "管簽的外門弟子翻了三頁，額上的汗滴進冊縫。",
      "sprite": "chen,signer",
      "goto": "s3_7",
      "type": "line"
    },
    "s3_7": {
      "id": "s3_7",
      "text": "回執法……黃耆，昨日記入一箱。今早……箱在籤上，貨不在架。",
      "speaker": "管簽",
      "goto": "s3_8",
      "type": "line"
    },
    "s3_8": {
      "id": "s3_8",
      "text": "空氣緊了一寸。沒有人看你。所有人都把視線釘在架空的那一格。",
      "sprite": "chen",
      "goto": "s3_9",
      "type": "line"
    },
    "s3_9": {
      "id": "s3_9",
      "text": "陳肅的筆停著。他仍不抬頭。",
      "goto": "s3_10",
      "type": "line"
    },
    "s3_10": {
      "id": "s3_10",
      "text": "缺一箱。記入者誰。",
      "speaker": "陳肅",
      "goto": "s3_11",
      "type": "line"
    },
    "s3_11": {
      "id": "s3_11",
      "text": "昨午……謝——謝師兄押入。經手雜役……",
      "speaker": "管簽",
      "goto": "s3_12",
      "type": "line"
    },
    "s3_12": {
      "id": "s3_12",
      "text": "他沒敢念你的名字，可冊上那一欄，陳肅已經用指節敲了兩下。",
      "goto": "s3_13",
      "type": "line"
    },
    "s3_13": {
      "id": "s3_13",
      "text": "你聽見自己的呼吸。旁邊有人把重心換到另一隻腳。",
      "goto": "s3_14",
      "type": "line"
    },
    "s3_14": {
      "id": "s3_14",
      "text": "門軸響。",
      "goto": "s3_15",
      "type": "line"
    },
    "s3_15": {
      "id": "s3_15",
      "text": "謝承淵進來的時候，先對陳肅一揖，再對滿庫的人點了點頭，像這間屋子本來就該有他的位置。青袍無塵。他站到你身側後半步，不遠不近，剛好把你擋在他袖影裡。",
      "sprite": "chen,xie",
      "goto": "s3_16",
      "type": "line"
    },
    "s3_16": {
      "id": "s3_16",
      "text": "陳執法。那一箱是我經手。功勞記我，錯也算我。外門雜役聽差辦事，不該擔這個名。",
      "speaker": "謝承淵",
      "goto": "s3_17",
      "type": "line"
    },
    "s3_17": {
      "id": "s3_17",
      "text": "像在替你解圍。你甚至來不及拒絕。",
      "goto": "s3_18",
      "type": "line"
    },
    "s3_18": {
      "id": "s3_18",
      "text": "陳肅這才抬眼。看的不是謝承淵的臉，是他腰間那枚內門玉牌。",
      "goto": "s3_19",
      "type": "line"
    },
    "s3_19": {
      "id": "s3_19",
      "text": "門規寫過。擔功者擔核。擔錯者，亦擔核。內門可記功，外門經手，仍要核。",
      "speaker": "陳肅",
      "goto": "s3_20",
      "type": "line"
    },
    "s3_20": {
      "id": "s3_20",
      "text": "他終於看向你。準確地說，看向你腳邊那塊磨凹的磚。",
      "goto": "s3_21",
      "type": "line"
    },
    "s3_21": {
      "id": "s3_21",
      "text": "你。昨天送箱的，出列。",
      "speaker": "陳肅",
      "goto": "s3_22",
      "type": "line"
    },
    "s3_22": {
      "id": "s3_22",
      "text": "謝承淵的袖輕輕碰了你的肘，像安撫，又像按住。",
      "goto": "s3_23",
      "type": "line"
    },
    "s3_23": {
      "id": "s3_23",
      "text": "執法明鑑。箱是我的事。這位{sib}，連封條都沒資格碰。",
      "speaker": "謝承淵",
      "goto": "s3_24",
      "type": "line"
    },
    "s3_24": {
      "id": "s3_24",
      "text": "出列。",
      "speaker": "陳肅",
      "goto": "s3_25",
      "type": "line"
    },
    "s3_25": {
      "id": "s3_25",
      "text": "你出列。滿庫的眼睛這才落到你身上，又很快挪開。看久了，像會沾上缺箱的灰。",
      "goto": "s3_ch",
      "type": "line"
    },
    "s3_ch": {
      "id": "s3_ch",
      "choices": [
        {
          "text": "看向謝承淵，等他說",
          "setFlags": {
            "wait_xie": 1,
            "xie_debt": "+1",
            "agency": "-1"
          },
          "goto": "s3_wait_1"
        },
        {
          "text": "是我。",
          "setFlags": {
            "admit_self": 1,
            "chen_note": "+1",
            "xie_watch": "+1",
            "he_trust": "+1"
          },
          "goto": "s3_admit_1"
        },
        {
          "text": "看向阿禾",
          "setFlags": {
            "look_he": 1
          },
          "goto": "s3_look_1"
        }
      ],
      "type": "choice"
    },
    "s3_wait_1": {
      "id": "s3_wait_1",
      "text": "你沒開口。下巴只偏了半寸。",
      "goto": "s3_wait_2",
      "type": "line"
    },
    "s3_wait_2": {
      "id": "s3_wait_2",
      "text": "謝承淵接得極熟，彷彿這就是他等的。",
      "goto": "s3_wait_3",
      "type": "line"
    },
    "s3_wait_3": {
      "id": "s3_wait_3",
      "text": "看見了。這孩子昨天跟我到庫門口，箱子我親手交給管簽。缺，從我查。外門的月例薄，別先往他們身上砍。",
      "speaker": "謝承淵",
      "goto": "s3_wait_4",
      "type": "line"
    },
    "s3_wait_4": {
      "id": "s3_wait_4",
      "text": "陳肅「嗯」了一聲。那不是答應，是把話收進冊裡。",
      "goto": "s3_wait_5",
      "type": "line"
    },
    "s3_wait_5": {
      "id": "s3_wait_5",
      "text": "內門弟子可自請核。外門在場經手，仍記一筆。站外庭。扣半月月例。完。",
      "speaker": "陳肅",
      "setFlags": {
        "dock_half": 1
      },
      "goto": "s3_wait_6",
      "type": "line"
    },
    "s3_wait_6": {
      "id": "s3_wait_6",
      "text": "硃筆落下。你還站著。謝承淵已經側過身，把你讓回列裡，像扶起一隻碗。",
      "goto": [
        {
          "if": {
            "he_confides": 1
          },
          "to": "s3_wait_conf"
        },
        {
          "if": {
            "he_fear": 1
          },
          "to": "s3_wait_fear"
        },
        {
          "to": "s4_1"
        }
      ],
      "type": "line"
    },
    "s3_wait_conf": {
      "id": "s3_wait_conf",
      "text": "阿禾的肩膀垮下去，像鬆，又像更怕——你把話權交了出去，他上午才把那箱事塞進你耳朵。",
      "goto": "s4_1",
      "type": "line"
    },
    "s3_wait_fear": {
      "id": "s3_wait_fear",
      "text": "阿禾連垮肩都不肯，只把後頸埋低。",
      "goto": "s4_1",
      "type": "line"
    },
    "s3_admit_1": {
      "id": "s3_admit_1",
      "text": "「是我。」你說。庫房裡有人倒吸氣，短促，隨即被自己咬住。",
      "goto": "s3_admit_2",
      "type": "line"
    },
    "s3_admit_2": {
      "id": "s3_admit_2",
      "text": "陳肅的筆尖在紙上停了一息。像沒料到外門還會認。",
      "goto": "s3_admit_3",
      "type": "line"
    },
    "s3_admit_3": {
      "id": "s3_admit_3",
      "text": "陳執法，別聽這句。外門不懂分寸，以為認了能少挨。箱是我的，認也該是我認。",
      "speaker": "謝承淵",
      "goto": "s3_admit_4",
      "type": "line"
    },
    "s3_admit_4": {
      "id": "s3_admit_4",
      "text": "他說「不懂分寸」的時候，目光從你臉上擦過，沒有怒，有一點可惜。像看一塊自己還沒擦乾淨的玉。",
      "goto": "s3_admit_5",
      "type": "line"
    },
    "s3_admit_5": {
      "id": "s3_admit_5",
      "text": "自認經手。記過一次。扣一月月例。站外庭至暮鼓。謝承淵——內門自請核，另案。先記『知情』。",
      "speaker": "陳肅",
      "setFlags": {
        "dock_full": 1
      },
      "goto": "s3_admit_6",
      "type": "line"
    },
    "s3_admit_6": {
      "id": "s3_admit_6",
      "text": "是。",
      "speaker": "謝承淵",
      "goto": "s3_admit_7",
      "type": "line"
    },
    "s3_admit_7": {
      "id": "s3_admit_7",
      "text": "知情兩個字落在他身上，輕得像拂袖。",
      "goto": [
        {
          "if": {
            "he_confides": 1
          },
          "to": "s3_admit_conf"
        },
        {
          "if": {
            "willful_blind": 1
          },
          "to": "s3_admit_blind"
        },
        {
          "if": {
            "he_fear": 1
          },
          "to": "s3_admit_fear"
        },
        {
          "to": "s4_1"
        }
      ],
      "type": "line"
    },
    "s3_admit_conf": {
      "id": "s3_admit_conf",
      "text": "阿禾眼底閃過一下，不是感激，是「你瘋了」。可他沒躲你的視線。",
      "goto": "s4_1",
      "type": "line"
    },
    "s3_admit_blind": {
      "id": "s3_admit_blind",
      "text": "他仍不看你。可喉結動了。",
      "goto": "s4_1",
      "type": "line"
    },
    "s3_admit_fear": {
      "id": "s3_admit_fear",
      "text": "他閉上眼。像聽見你把爬的路當眾踩裂了一角。",
      "goto": "s4_1",
      "type": "line"
    },
    "s3_look_1": {
      "id": "s3_look_1",
      "text": "你的視線偏了。很短。陳肅未必看見。謝承淵看見了。",
      "goto": [
        {
          "if": {
            "he_confides": 1
          },
          "to": "s3_look_conf_1"
        },
        {
          "if": {
            "he_fear": 1
          },
          "to": "s3_look_fear_1"
        },
        {
          "if": {
            "willful_blind": 1
          },
          "to": "s3_look_blind_1"
        },
        {
          "to": "s3_look_blind_1"
        }
      ],
      "type": "line"
    },
    "s3_look_conf_1": {
      "id": "s3_look_conf_1",
      "text": "阿禾的嘴張了一下。汗順著鬢角進領口。他沒喊你的名字，只對著地面說：",
      "sprite": "chen,xie",
      "goto": "s3_look_conf_2",
      "type": "line"
    },
    "s3_look_conf_2": {
      "id": "s3_look_conf_2",
      "text": "……昨午我在夾道打水。看見謝師兄帶人送箱。箱……比黃耆沉。",
      "speaker": "阿禾",
      "goto": "s3_look_conf_3",
      "type": "line"
    },
    "s3_look_conf_3": {
      "id": "s3_look_conf_3",
      "text": "話出口，他自己先白了。陳肅的目光從冊上抬起，第一次正對一個人。",
      "goto": "s3_look_conf_4",
      "type": "line"
    },
    "s3_look_conf_4": {
      "id": "s3_look_conf_4",
      "text": "外門。你叫什麼。",
      "speaker": "陳肅",
      "goto": "s3_look_conf_5",
      "type": "line"
    },
    "s3_look_conf_5": {
      "id": "s3_look_conf_5",
      "text": "阿禾。我沒開箱。我什麼都沒開。",
      "speaker": "阿禾",
      "goto": "s3_look_conf_6",
      "type": "line"
    },
    "s3_look_conf_6": {
      "id": "s3_look_conf_6",
      "text": "阿禾，旁證。記。送箱者，仍出列核。看同門，不看執法。膽，或黨。先按膽記。",
      "speaker": "陳肅",
      "goto": "s3_look_conf_7",
      "type": "line"
    },
    "s3_look_conf_7": {
      "id": "s3_look_conf_7",
      "text": "執法，這兩個外門昨天都聽我差遣。旁證也好，經手也好，根子在我。",
      "speaker": "謝承淵",
      "goto": "s3_look_conf_8",
      "type": "line"
    },
    "s3_look_conf_8": {
      "id": "s3_look_conf_8",
      "text": "根子另核。枝葉先剪。你，記過，扣半月月例，站外庭。阿禾——多嘴，罰掃執法堂階三日。",
      "speaker": "陳肅",
      "setFlags": {
        "dock_half": 1,
        "he_sweep_hall": 1
      },
      "goto": "s3_look_conf_9",
      "type": "line"
    },
    "s3_look_conf_9": {
      "id": "s3_look_conf_9",
      "text": "是。",
      "speaker": "阿禾",
      "goto": "s3_look_conf_10",
      "type": "line"
    },
    "s3_look_conf_10": {
      "id": "s3_look_conf_10",
      "text": "聲音裂了。他沒恨你——至少此刻沒有。他只是發現：可以說話的人，代價是一起被寫進冊。",
      "goto": "s4_1",
      "type": "line"
    },
    "s3_look_fear_1": {
      "id": "s3_look_fear_1",
      "text": "阿禾比你更快低頭。下巴幾乎碰到鎖骨。像早知道你會找他，也早準備好不當人。",
      "goto": "s3_look_fear_2",
      "type": "line"
    },
    "s3_look_fear_2": {
      "id": "s3_look_fear_2",
      "text": "外門東張西望。記過，扣半月月例，站外庭。",
      "speaker": "陳肅",
      "setFlags": {
        "dock_half": 1,
        "punish_look": 1
      },
      "goto": "s3_look_fear_3",
      "type": "line"
    },
    "s3_look_fear_3": {
      "id": "s3_look_fear_3",
      "text": "別看旁人。看我。",
      "speaker": "謝承淵",
      "goto": "s3_look_fear_4",
      "type": "line"
    },
    "s3_look_fear_4": {
      "id": "s3_look_fear_4",
      "text": "這句極輕，只有你聽得見。阿禾始終沒抬眼。你知道他記住了。不是記住缺箱，是記住你差一點把他拖出來。",
      "goto": "s4_1",
      "type": "line"
    },
    "s3_look_blind_1": {
      "id": "s3_look_blind_1",
      "text": "阿禾的臉空著，像真的什麼都沒看見。這一次，他演得比你上午還像。",
      "goto": "s3_look_blind_2",
      "type": "line"
    },
    "s3_look_blind_2": {
      "id": "s3_look_blind_2",
      "text": "東張西望者，心不在冊。記過，扣半月月例，站外庭。",
      "speaker": "陳肅",
      "setFlags": {
        "dock_half": 1,
        "punish_look": 1
      },
      "goto": "s3_look_blind_3",
      "type": "line"
    },
    "s3_look_blind_3": {
      "id": "s3_look_blind_3",
      "text": "沒有旁證，沒有自認，也沒有師兄把話全攬走。處罰落在「神色」上——門規裡最軟、也最隨便的一刀。",
      "goto": "s3_look_blind_4",
      "type": "line"
    },
    "s3_look_blind_4": {
      "id": "s3_look_blind_4",
      "text": "謝承淵微微頷首，像對這結果並不意外。",
      "goto": "s4_1",
      "type": "line"
    },
    "s4_1": {
      "id": "s4_1",
      "text": "庫房外庭。日頭正中。青石返白。罰站的人影短。",
      "background": "外庭",
      "sprite": "chen,xie",
      "scene": "外庭",
      "goto": "s4_2",
      "type": "line"
    },
    "s4_2": {
      "id": "s4_2",
      "text": "處罰不當著內門弟子的面宣。陳肅把冊合上，對謝承淵說了兩句聽不清的話，硃砂在他指間未乾。",
      "goto": "s4_3",
      "type": "line"
    },
    "s4_3": {
      "id": "s4_3",
      "text": "盤庫有缺，是我檢點不周。勞各位受累。",
      "speaker": "謝承淵",
      "goto": "s4_4",
      "type": "line"
    },
    "s4_4": {
      "id": "s4_4",
      "text": "受累兩個字說得漂亮。外門沒人接。有人盯著自己的鞋尖，像鞋尖能少扣一錢月例。",
      "goto": "s4_5",
      "type": "line"
    },
    "s4_5": {
      "id": "s4_5",
      "text": "他經過你身邊時，停了半步。",
      "goto": [
        {
          "if": {
            "wait_xie": 1
          },
          "to": "s4_xie_wait"
        },
        {
          "if": {
            "admit_self": 1
          },
          "to": "s4_xie_admit"
        },
        {
          "if": {
            "look_he": 1,
            "he_confides": 1
          },
          "to": "s4_xie_look_conf"
        },
        {
          "if": {
            "look_he": 1,
            "he_fear": 1
          },
          "to": "s4_xie_look_fear"
        },
        {
          "if": {
            "look_he": 1,
            "willful_blind": 1
          },
          "to": "s4_xie_look_blind"
        },
        {
          "to": "s4_6"
        }
      ],
      "type": "line"
    },
    "s4_xie_wait": {
      "id": "s4_xie_wait",
      "text": "你很穩。穩就好。今晚不必怕。有事，我擔。",
      "speaker": "謝承淵",
      "setFlags": {
        "xie_cover": 1
      },
      "goto": "s4_xie_wait_n",
      "type": "line"
    },
    "s4_xie_wait_n": {
      "id": "s4_xie_wait_n",
      "text": "他的「擔」，聽著像傘，看著像繩。",
      "goto": "s4_6",
      "type": "line"
    },
    "s4_xie_admit": {
      "id": "s4_xie_admit",
      "text": "認得乾脆，也好。下次把乾脆留給該認的人。你月例我讓人補一半——別跟執法堂說是我。",
      "speaker": "謝承淵",
      "setFlags": {
        "xie_bait": 1
      },
      "goto": "s4_xie_admit_n",
      "type": "line"
    },
    "s4_xie_admit_n": {
      "id": "s4_xie_admit_n",
      "text": "補一半，是恩，也是欠。",
      "goto": "s4_6",
      "type": "line"
    },
    "s4_xie_look_conf": {
      "id": "s4_xie_look_conf",
      "text": "同門之間，話少些。陳執法最厭外門成串。",
      "speaker": "謝承淵",
      "setFlags": {
        "xie_watch": "+1"
      },
      "goto": "s4_6",
      "type": "line"
    },
    "s4_xie_look_fear": {
      "id": "s4_xie_look_fear",
      "text": "他什麼都沒說。只把摺扇在掌裡合上。那一下輕響，像替阿禾的低頭收場。",
      "goto": "s4_6",
      "type": "line"
    },
    "s4_xie_look_blind": {
      "id": "s4_xie_look_blind",
      "text": "神色也是罪。下次把眼睛放在自己腳尖上。",
      "speaker": "謝承淵",
      "setFlags": {
        "xie_watch": "+1"
      },
      "goto": "s4_6",
      "type": "line"
    },
    "s4_6": {
      "id": "s4_6",
      "text": "謝承淵走了。內門青袍沒入廊轉角，藥香還在。",
      "sprite": "chen",
      "goto": "s4_7",
      "type": "line"
    },
    "s4_7": {
      "id": "s4_7",
      "text": "陳肅這才對著外門開口。他唸的是條文，不是人名。",
      "goto": "s4_8",
      "type": "line"
    },
    "s4_8": {
      "id": "s4_8",
      "text": "缺貨，經手列記過。月例按冊扣。站外庭，至暮鼓。再有差，逐出山門，名冊除名。",
      "speaker": "陳肅",
      "goto": "s4_9",
      "type": "line"
    },
    "s4_9": {
      "id": "s4_9",
      "text": "沒有鞭。沒有血。日頭把青石曬得發燙，罰站的人腳下很快出了一層汗印。管簽的那個外門弟子站在你左側，牙齒咬著內側，不敢跪——跪是求情，求情另記一筆「無骨」。",
      "sprite": "none",
      "goto": "s4_10",
      "type": "line"
    },
    "s4_10": {
      "id": "s4_10",
      "text": "你的月例本就薄。扣半月或一月，意味著往後三十日裡，醬要兌水，炭要省。這是門規。門規合法。",
      "goto": [
        {
          "if": {
            "he_sweep_hall": 1
          },
          "to": "s4_sweep"
        },
        {
          "to": "s4_11"
        }
      ],
      "type": "line"
    },
    "s4_sweep": {
      "id": "s4_sweep",
      "text": "阿禾經過你面前時，掃帚撞了一下你的踝骨。不像故意，也不像道歉。",
      "sprite": "ahe",
      "goto": "s4_11",
      "type": "line"
    },
    "s4_11": {
      "id": "s4_11",
      "text": "其餘人散去值事。外庭只留罰站的幾個。蟬在很高的地方叫。沒有人說話。",
      "sprite": "none",
      "goto": "s4_12",
      "type": "line"
    },
    "s4_12": {
      "id": "s4_12",
      "text": "陳肅的案撤了。他臨走把那頁缺箱的紙夾進袖裡，不是當眾燒，是帶走。帶走的東西，比當眾燒更難討。",
      "goto": "s4_13",
      "type": "line"
    },
    "s4_13": {
      "id": "s4_13",
      "text": "你站著。日影從腳尖爬到腳踝。這就是青衡宗的刀：不砍頭，砍日子。",
      "goto": "s5_1",
      "type": "line"
    },
    "s5_1": {
      "id": "s5_1",
      "text": "外門值事房外廊。暮鼓將起未起。罰站結束，人被趕回點晚冊。",
      "background": "值事房外廊",
      "sprite": "clerk",
      "scene": "值事房外廊",
      "goto": "s5_2",
      "type": "line"
    },
    "s5_2": {
      "id": "s5_2",
      "text": "晚冊比晨冊快。值事的人只報在、不在、病、差。輪到一個空缺，他停了。",
      "goto": "s5_3",
      "type": "line"
    },
    "s5_3": {
      "id": "s5_3",
      "text": "劉三。",
      "speaker": "值事",
      "goto": "s5_4",
      "type": "line"
    },
    "s5_4": {
      "id": "s5_4",
      "text": "沒人應。有人在後列吸了下鼻子。",
      "goto": "s5_5",
      "type": "line"
    },
    "s5_5": {
      "id": "s5_5",
      "text": "值事翻過一頁，用事先備好的口氣念：",
      "goto": "s5_6",
      "type": "line"
    },
    "s5_6": {
      "id": "s5_6",
      "text": "上月薦往南邊聯姻。按例除名。",
      "speaker": "值事",
      "goto": "s5_7",
      "type": "line"
    },
    "s5_7": {
      "id": "s5_7",
      "text": "筆尖在「除」上頓了頓，像這字寫過很多次，每次還是要頓。",
      "goto": "s5_8",
      "type": "line"
    },
    "s5_8": {
      "id": "s5_8",
      "text": "你記得劉三。上月還在這條廊外掃地。手背有凍裂的口，說話漏風。他提過家裡還有個妹妹，在鎮裡幫人漿衣，等他月例寄回去。月例寄不了幾回。後來他幫人搬過箱子——",
      "goto": [
        {
          "if": {
            "he_confides": 1
          },
          "to": "s5_mem_conf"
        },
        {
          "to": "s5_mem_else"
        }
      ],
      "type": "line"
    },
    "s5_mem_conf": {
      "id": "s5_mem_conf",
      "text": "阿禾上午開過口。這句在你腦子裡對上了。那陣子他突然有新草鞋，新得很假。",
      "goto": "s5_9",
      "type": "line"
    },
    "s5_mem_else": {
      "id": "s5_mem_else",
      "text": "你自己想起來了：那陣子他突然有新草鞋，新得很假。",
      "goto": "s5_9",
      "type": "line"
    },
    "s5_9": {
      "id": "s5_9",
      "text": "沒有人問南邊是哪一家。沒有人問聯姻是娶還是被娶。薦，是上對下的字。除名，是門規的字。兩個字並在一起，人就從冊上蒸發。",
      "goto": "s5_10",
      "type": "line"
    },
    "s5_10": {
      "id": "s5_10",
      "text": "廊外有靴聲。比內門弟子齊，比執法堂沉。",
      "goto": "s5_11",
      "type": "line"
    },
    "s5_11": {
      "id": "s5_11",
      "text": "衛長老。",
      "speaker": "某人",
      "goto": "s5_12",
      "type": "line"
    },
    "s5_12": {
      "id": "s5_12",
      "text": "你們這一列幾乎同時折腰。衛正言從遠廊過去，青衣，鬚整齊，像門規本身會走路。他沒停。也沒往外門這邊看。有個內門弟子小跑著跟上，把一卷東西捧在胸前，封面朝下。",
      "sprite": "wei:far",
      "goto": "s5_13",
      "type": "line"
    },
    "s5_13": {
      "id": "s5_13",
      "text": "衛正言略側了側臉。那不是對你們。是對那卷東西。他點一下頭，進了月門。",
      "goto": "s5_14",
      "type": "line"
    },
    "s5_14": {
      "id": "s5_14",
      "text": "值事的人等靴聲遠了，才把晚冊合上，喉嚨裡的敬畏還沒收。",
      "sprite": "clerk",
      "goto": "s5_15",
      "type": "line"
    },
    "s5_15": {
      "id": "s5_15",
      "text": "散。明日寅時，外庭再掃。",
      "speaker": "值事",
      "goto": "s5_16",
      "type": "line"
    },
    "s5_16": {
      "id": "s5_16",
      "text": "南邊……是哪個府。",
      "speaker": "某人",
      "goto": "s5_17",
      "type": "line"
    },
    "s5_17": {
      "id": "s5_17",
      "text": "沒人答。問的人自己也把話咬斷。問這個，像問自己下個月還在不在冊上。",
      "goto": "s5_18",
      "type": "line"
    },
    "s5_18": {
      "id": "s5_18",
      "text": "你經過名冊案。劉三的那一格已經空了，只留下一個「除」的墨點，滲進下一行的邊。妹妹這兩個字沒地方寫。門規不收家屬。",
      "sprite": "none",
      "goto": [
        {
          "if": {
            "he_confides": 1
          },
          "to": "s5_ahe_conf"
        },
        {
          "if": {
            "he_fear": 1
          },
          "to": "s5_ahe_fear"
        },
        {
          "if": {
            "willful_blind": 1
          },
          "to": "s5_ahe_blind"
        },
        {
          "to": "s5_19"
        }
      ],
      "type": "line"
    },
    "s5_ahe_conf": {
      "id": "s5_ahe_conf",
      "text": "你看見阿禾的目光也在那一格上停過。他沒說「箱子」。他現在連「黃耆」都不會再提。",
      "goto": "s5_19",
      "type": "line"
    },
    "s5_ahe_fear": {
      "id": "s5_ahe_fear",
      "text": "阿禾走在最前面，步伐穩得像要證明自己與任何除名無關。",
      "goto": "s5_19",
      "type": "line"
    },
    "s5_ahe_blind": {
      "id": "s5_ahe_blind",
      "text": "你沒去看那一格。可你知道它在哪。假裝沒看見，比看見更費力。",
      "goto": "s5_19",
      "type": "line"
    },
    "s5_19": {
      "id": "s5_19",
      "text": "暮鼓響了。山門那一側的燈先亮。外門這邊晚一盞。",
      "goto": "s6_1",
      "type": "line"
    },
    "s6_1": {
      "id": "s6_1",
      "text": "通鋪的人睡得早。罰站過的，腿還在抖，可眼先閉——閉了，才不像還在外庭。",
      "background": "外門通舖",
      "sprite": "none",
      "scene": "外門通鋪",
      "goto": "s6_2",
      "type": "line"
    },
    "s6_2": {
      "id": "s6_2",
      "text": "你沒睡。月例被扣的數在腦子裡反覆加，加不出一雙草鞋，加得出劉三的空格。",
      "goto": [
        {
          "if": {
            "he_confides": 1
          },
          "to": "s6_conf_0"
        },
        {
          "if": {
            "willful_blind": 1
          },
          "to": "s6_blind_1"
        },
        {
          "if": {
            "he_fear": 1
          },
          "to": "s6_fear_1"
        },
        {
          "to": "s7_1"
        }
      ],
      "type": "line"
    },
    "s6_conf_0": {
      "id": "s6_conf_0",
      "text": "門縫響。",
      "sprite": "ahe",
      "goto": [
        {
          "if": {
            "he_sweep_hall": 1
          },
          "to": "s6_conf_ash"
        },
        {
          "to": "s6_conf_smell"
        }
      ],
      "type": "line"
    },
    "s6_conf_ash": {
      "id": "s6_conf_ash",
      "text": "阿禾鑽進來，身上還有執法堂階上的灰。",
      "goto": "s6_conf_2",
      "type": "line"
    },
    "s6_conf_smell": {
      "id": "s6_conf_smell",
      "text": "阿禾鑽進來，身上還是庫房那味。",
      "goto": "s6_conf_2",
      "type": "line"
    },
    "s6_conf_2": {
      "id": "s6_conf_2",
      "text": "他蹲在你鋪邊，近得能聞見他牙上的苦。",
      "goto": "s6_conf_3",
      "type": "line"
    },
    "s6_conf_3": {
      "id": "s6_conf_3",
      "text": "你上午問那箱。",
      "speaker": "阿禾",
      "goto": "s6_conf_4",
      "type": "line"
    },
    "s6_conf_4": {
      "id": "s6_conf_4",
      "text": "他說，像在埋怨你問，又像慶幸你問。",
      "goto": "s6_conf_5",
      "type": "line"
    },
    "s6_conf_5": {
      "id": "s6_conf_5",
      "text": "我午後聽管簽的人——聽他們罵自己。黃耆的籤是真的。秤是假的。箱出庫的時候，比入庫輕。",
      "speaker": "阿禾",
      "goto": "s6_conf_6",
      "type": "line"
    },
    "s6_conf_6": {
      "id": "s6_conf_6",
      "text": "你等他。他最怕的就是你等他。",
      "goto": "s6_conf_7",
      "type": "line"
    },
    "s6_conf_7": {
      "id": "s6_conf_7",
      "text": "輕的不是藥。像把裡面的東西換走了。謝師兄當眾攬過，陳執法把那頁紙袖走。內門的功，外門的過。劉三走的時候，也是先攬過一次事。",
      "speaker": "阿禾",
      "goto": "s6_conf_8",
      "type": "line"
    },
    "s6_conf_8": {
      "id": "s6_conf_8",
      "text": "他掏出半塊冷饃，掰給你——不是慷慨，是怕你明天站不住。",
      "goto": "s6_conf_9",
      "type": "line"
    },
    "s6_conf_9": {
      "id": "s6_conf_9",
      "text": "我不是好人。我只是還沒被薦走。",
      "speaker": "阿禾",
      "goto": "s6_conf_10",
      "type": "line"
    },
    "s6_conf_10": {
      "id": "s6_conf_10",
      "text": "他停。聽過走廊有沒有人。",
      "goto": "s6_conf_11",
      "type": "line"
    },
    "s6_conf_11": {
      "id": "s6_conf_11",
      "text": "你今天下午看不看我，陳執法都記下了。謝師兄也記下了。你要揭，今晚不是時候。你要爬，別從我爬上去。你要走——走也要有名帖。外門沒名帖，山門當逃。",
      "speaker": "阿禾",
      "goto": "s6_conf_12",
      "type": "line"
    },
    "s6_conf_12": {
      "id": "s6_conf_12",
      "text": "他站起來，又蹲回去，把最後半句丟在燈影外：",
      "goto": "s6_conf_13",
      "type": "line"
    },
    "s6_conf_13": {
      "id": "s6_conf_13",
      "text": "那箱蓋上有內門火漆。火漆不是武功能仿的。我不知道那是什麼。我只知道不像我們練的那些。",
      "speaker": "阿禾",
      "goto": "s6_conf_14",
      "type": "line"
    },
    "s6_conf_14": {
      "id": "s6_conf_14",
      "text": "這是他能給你的全部。內門功法的邊，他只敢用「不像」去碰。",
      "goto": "s6_conf_15",
      "type": "line"
    },
    "s6_conf_15": {
      "id": "s6_conf_15",
      "text": "他走了。門縫合上。你手裡那半塊饃，涼。",
      "sprite": "none",
      "setFlags": {
        "he_bond": 1,
        "box_clue": 1,
        "inner_unlike": 1
      },
      "goto": "s7_1",
      "type": "line"
    },
    "s6_blind_1": {
      "id": "s6_blind_1",
      "text": "阿禾沒來。",
      "sprite": "none",
      "goto": "s6_blind_2",
      "type": "line"
    },
    "s6_blind_2": {
      "id": "s6_blind_2",
      "text": "你聽過他的脚步在走廊停了一停，又走了。像把上午那句「你沒看見」又確認了一遍。確認完，他就沒必要進來。",
      "goto": "s6_blind_3",
      "type": "line"
    },
    "s6_blind_3": {
      "id": "s6_blind_3",
      "text": "燈結了花。你把燈芯撥正。窗外庫房那向，有人巡夜，燈籠一晃，黃耆的空架在腦子裡也晃。",
      "goto": "s6_blind_4",
      "type": "line"
    },
    "s6_blind_4": {
      "id": "s6_blind_4",
      "text": "三更將盡時，門外極輕地響了一下。不是阿禾。一隻手把一個油紙包從門檻下推進來，沒留名。",
      "goto": "s6_blind_5",
      "type": "line"
    },
    "s6_blind_5": {
      "id": "s6_blind_5",
      "text": "紙包裡是兩文錢，和一張內門箋，箋上只有一行字，墨極淡：",
      "goto": "s6_blind_6",
      "type": "line"
    },
    "s6_blind_6": {
      "id": "s6_blind_6",
      "text": "缺箱之事，已了。好好當差。",
      "speaker": "箋",
      "goto": "s6_blind_7",
      "type": "line"
    },
    "s6_blind_7": {
      "id": "s6_blind_7",
      "text": "沒有落款。可「已了」這種口氣，外門寫不出來。謝承淵不必親自來。他派人，就像他攬過——手不髒，情分記在你這邊。",
      "goto": "s6_blind_ch",
      "type": "line"
    },
    "s6_blind_ch": {
      "id": "s6_blind_ch",
      "choices": [
        {
          "text": "把錢收下",
          "setFlags": {
            "xie_message": 1,
            "he_distance": 1,
            "safe": "+1",
            "keep_coin": 1
          },
          "goto": "s6_blind_end"
        },
        {
          "text": "連箋一起塞進枕下",
          "setFlags": {
            "xie_message": 1,
            "he_distance": 1,
            "safe": "+1",
            "hide_note": 1
          },
          "goto": "s6_blind_end"
        }
      ],
      "type": "choice"
    },
    "s6_blind_end": {
      "id": "s6_blind_end",
      "text": "錢是真的。了，未必。",
      "goto": "s7_1",
      "type": "line"
    },
    "s6_fear_1": {
      "id": "s6_fear_1",
      "text": "阿禾不來。你也沒指望。",
      "sprite": "none",
      "goto": "s6_fear_2",
      "type": "line"
    },
    "s6_fear_2": {
      "id": "s6_fear_2",
      "text": "子時未到，內門一個雜役在門外咳嗽。那咳嗽是敲門。你出去。",
      "background": "夜夾道",
      "goto": "s6_fear_3",
      "type": "line"
    },
    "s6_fear_3": {
      "id": "s6_fear_3",
      "text": "廊下只有這一個人，提著燈，燈罩壓得很低。",
      "sprite": "servant",
      "goto": "s6_fear_4",
      "type": "line"
    },
    "s6_fear_4": {
      "id": "s6_fear_4",
      "text": "謝師兄有話。今日當眾認也好，不認也好，陳執法的冊已經合了。師兄說：外門想活命，第一件事是別跟錯人說話。第二件事——明日掃葉，掃到內門側門即可。有人會看見。",
      "speaker": "內門雜役",
      "goto": "s6_fear_5",
      "type": "line"
    },
    "s6_fear_5": {
      "id": "s6_fear_5",
      "text": "「看見」是獎賞。內門側門不是外門該久停的地方。能被看見，就是能被想起。能被想起，才有機會從名冊的底欄往上挪一格。",
      "goto": "s6_fear_6",
      "type": "line"
    },
    "s6_fear_6": {
      "id": "s6_fear_6",
      "text": "雜役把一封未拆的紙條塞過來。封泥是素的，不是火漆。",
      "goto": "s6_fear_7",
      "type": "line"
    },
    "s6_fear_7": {
      "id": "s6_fear_7",
      "text": "師兄說：看不看，隨你。看了，別給第三個人。",
      "speaker": "內門雜役",
      "goto": "s6_fear_8",
      "type": "line"
    },
    "s6_fear_8": {
      "id": "s6_fear_8",
      "text": "他走了。你靠著門框。紙條在掌心發潮。",
      "sprite": "none",
      "setFlags": {
        "xie_line": 1,
        "he_alien": 1,
        "climb_lean": "+1"
      },
      "goto": "s6_fear_9",
      "type": "line"
    },
    "s6_fear_9": {
      "id": "s6_fear_9",
      "text": "拆，或不拆，都已經是爬。阿禾會從明天起把你當成另一種人——不是同門，是會把話送進內門的人。",
      "goto": "s6_fear_ch",
      "type": "line"
    },
    "s6_fear_ch": {
      "id": "s6_fear_ch",
      "choices": [
        {
          "text": "拆開紙條",
          "setFlags": {
            "south_quota": 1,
            "open_note": 1
          },
          "goto": "s6_fear_open"
        },
        {
          "text": "不拆",
          "setFlags": {
            "note_sealed": 1
          },
          "goto": "s6_fear_end"
        }
      ],
      "type": "choice"
    },
    "s6_fear_open": {
      "id": "s6_fear_open",
      "text": "南邊的薦，不是每年都有。今年已滿。",
      "speaker": "紙條",
      "goto": "s6_fear_open_n",
      "type": "line"
    },
    "s6_fear_open_n": {
      "id": "s6_fear_open_n",
      "text": "像安慰。像提醒。像告訴你劉三的位子今年不再缺，你暫時還能掃地。",
      "goto": "s7_1",
      "type": "line"
    },
    "s6_fear_end": {
      "id": "s6_fear_end",
      "text": "紙條未拆。封泥在指腹上發黏。爬，已經開始了。",
      "goto": "s7_1",
      "type": "line"
    },
    "s7_1": {
      "id": "s7_1",
      "text": "燈油還剩一截。你還能做一件事。做完，夜就深了。明天寅時仍要掃外庭。名冊仍在。缺的那箱黃耆仍不在架上。",
      "background": "外門通舖",
      "sprite": "none",
      "scene": "夜深之前",
      "goto": "s7_ch",
      "type": "line"
    },
    "s7_ch": {
      "id": "s7_ch",
      "choices": [
        {
          "text": "夜探庫房",
          "setFlags": {
            "night_warehouse": 1,
            "risk": "+1"
          },
          "goto": "s7_wh_1"
        },
        {
          "text": "睡",
          "setFlags": {
            "sleep": 1,
            "safe": "+2",
            "info": "-1"
          },
          "goto": "s7_sleep_1"
        },
        {
          "text": "去找阿禾問清楚",
          "setFlags": {
            "find_he": 1
          },
          "goto": "s7_he_1"
        },
        {
          "text": "去謝承淵處請安",
          "setFlags": {
            "xie_greet": 1,
            "climb_lean": "+2",
            "xie_favor": "+1",
            "escape_lean": "-1",
            "reveal_lean": "-1"
          },
          "goto": "s7_xie_1"
        }
      ],
      "type": "choice"
    },
    "s7_wh_1": {
      "id": "s7_wh_1",
      "text": "你赤足走夾道。巡夜的燈籠在另一頭，還有兩轉的距離。",
      "background": "夜夾道",
      "scene": "夜探庫房",
      "goto": "s7_wh_2",
      "type": "line"
    },
    "s7_wh_2": {
      "id": "s7_wh_2",
      "text": "庫房的鎖是外門的鎖，鑰匙在管鑰那邊——你沒有鑰匙。可罰站的下午，你看見陳肅袖走那頁紙之後，側門的門閂只是虛扣。盤庫的日子，人以為鎖過了，手就鬆。",
      "goto": "s7_wh_3",
      "type": "line"
    },
    "s7_wh_3": {
      "id": "s7_wh_3",
      "text": "你進去。沒有開燈。鼻尖先碰到空架。黃耆那一格，籤還在，墨新。格子裡剩幾根斷的麻繩，繩上有火漆碎渣，紅得發黑。",
      "background": "庫房",
      "goto": "s7_wh_4",
      "type": "line"
    },
    "s7_wh_4": {
      "id": "s7_wh_4",
      "text": "你摸到箱底沒被掃走的一塊木屑。木屑裡夾著半枚極薄的牙牌，像名帖，又不是名帖。牌上刻的不是功法名，是一個「薦」字，小得要用指甲去湊。",
      "setFlags": {
        "token_jian": 1
      },
      "goto": [
        {
          "if": {
            "box_clue": 1
          },
          "to": "s7_wh_clue"
        },
        {
          "to": "s7_wh_noclue"
        }
      ],
      "type": "line"
    },
    "s7_wh_clue": {
      "id": "s7_wh_clue",
      "text": "這與阿禾說的「換走」對得上。藥是皮，薦是骨。",
      "goto": "s7_wh_5",
      "type": "line"
    },
    "s7_wh_noclue": {
      "id": "s7_wh_noclue",
      "text": "你只知道這箱從來不是給外門治風寒的。",
      "goto": "s7_wh_5",
      "type": "line"
    },
    "s7_wh_5": {
      "id": "s7_wh_5",
      "text": "門軸遠處響了一下。不是巡夜。是有人在內門那側停步，停得很有教養，像謝承淵走路的那種停。你把牙牌塞進鞋裡，退回虛扣的門。沒被看見——至少你以為沒有。",
      "goto": "s7_wh_6",
      "type": "line"
    },
    "s7_wh_6": {
      "id": "s7_wh_6",
      "text": "你回到鋪上時，腿比罰站時更白。牙牌硌著腳心。夜深了。你沒有揭開任何事。你只是把一塊會割腳的東西，帶進了睡覺的地方。",
      "background": "外門通舖",
      "setFlags": {
        "reveal_lean": "+1"
      },
      "goto": "end_1",
      "type": "line"
    },
    "s7_sleep_1": {
      "id": "s7_sleep_1",
      "text": "你把燈吹了。",
      "background": "外門通舖",
      "scene": "睡",
      "goto": "s7_sleep_2",
      "type": "line"
    },
    "s7_sleep_2": {
      "id": "s7_sleep_2",
      "text": "黑暗裡，劉三的空格、黃耆的空架、陳肅的硃筆，都還在，可你選擇先讓腿停。外門能活到下一頁名冊的人，多半不是最明白的人，是最能把明白推遲到明天的人。",
      "goto": [
        {
          "if": {
            "xie_message": 1
          },
          "to": "s7_sleep_msg"
        },
        {
          "if": {
            "he_bond": 1
          },
          "to": "s7_sleep_bond"
        },
        {
          "if": {
            "xie_line": 1
          },
          "to": "s7_sleep_line"
        },
        {
          "to": "s7_sleep_3"
        }
      ],
      "type": "line"
    },
    "s7_sleep_msg": {
      "id": "s7_sleep_msg",
      "text": "那兩文錢在枕下，像有人替你把夜守著。你沒有因此更安。",
      "goto": "s7_sleep_3",
      "type": "line"
    },
    "s7_sleep_bond": {
      "id": "s7_sleep_bond",
      "text": "饃的渣還在牙縫裡。阿禾的「不像我們練的那些」你沒追問。沒追問，問才還在。",
      "goto": "s7_sleep_3",
      "type": "line"
    },
    "s7_sleep_line": {
      "id": "s7_sleep_line",
      "text": "紙條無論拆不拆，都在鋪板下。你側過身，背對它，像背對一扇還沒開的側門。",
      "goto": "s7_sleep_3",
      "type": "line"
    },
    "s7_sleep_3": {
      "id": "s7_sleep_3",
      "text": "你睡著。不是因為無事。是因為寅時會來。夜深，山門的燈還亮著內門那一排。外門這一排，滅了。",
      "setFlags": {
        "rest": 1
      },
      "goto": "end_1",
      "type": "line"
    },
    "s7_he_1": {
      "id": "s7_he_1",
      "text": "阿禾住在通鋪盡頭那間更潮的小房，從前是裝筍乾的。你敲門，用指甲，不聲張。",
      "background": "夜夾道",
      "scene": "找阿禾",
      "goto": [
        {
          "if": {
            "he_confides": 1
          },
          "to": "s7_he_conf_1"
        },
        {
          "if": {
            "willful_blind": 1
          },
          "to": "s7_he_blind_1"
        },
        {
          "if": {
            "he_fear": 1
          },
          "to": "s7_he_fear_1"
        },
        {
          "to": "s7_he_fear_1"
        }
      ],
      "type": "line"
    },
    "s7_he_conf_1": {
      "id": "s7_he_conf_1",
      "text": "門開一條縫。他先看見是你，才把人讓進去。房裡連燈都不敢點，只有窗外的一點天光。",
      "sprite": "ahe",
      "goto": "s7_he_conf_2",
      "type": "line"
    },
    "s7_he_conf_2": {
      "id": "s7_he_conf_2",
      "text": "你還來。陳執法的冊合了，不等於他忘。",
      "speaker": "阿禾",
      "goto": "s7_he_conf_3",
      "type": "line"
    },
    "s7_he_conf_3": {
      "id": "s7_he_conf_3",
      "text": "你要問的，他知道。黃耆、劉三、謝承淵的攬。",
      "goto": "s7_he_conf_4",
      "type": "line"
    },
    "s7_he_conf_4": {
      "id": "s7_he_conf_4",
      "text": "我能說的，燈邊已經說了。還能說的只有一句：南邊聯姻的名，不是府裡點的。是門裡薦的。薦的人吃禮。被薦的人——有的成親，有的連親事都沒見到，名冊就除了。",
      "speaker": "阿禾",
      "goto": "s7_he_conf_5",
      "type": "line"
    },
    "s7_he_conf_5": {
      "id": "s7_he_conf_5",
      "text": "你要揭，得有比我這張嘴硬的東西。你要爬，謝師兄今天下午已經向你伸手了。你要逃——逃的人，名冊上寫的是『叛』，比『除』更乾淨，也更死。",
      "speaker": "阿禾",
      "goto": "s7_he_conf_6",
      "type": "line"
    },
    "s7_he_conf_6": {
      "id": "s7_he_conf_6",
      "text": "他送你到門口，聲音更低：",
      "goto": "s7_he_conf_7",
      "type": "line"
    },
    "s7_he_conf_7": {
      "id": "s7_he_conf_7",
      "text": "別再敲。第三次，我就當沒你這個人。",
      "speaker": "阿禾",
      "goto": "s7_he_conf_8",
      "type": "line"
    },
    "s7_he_conf_8": {
      "id": "s7_he_conf_8",
      "text": "這不是絕交。這是保命的說法。你聽得懂。",
      "setFlags": {
        "he_bond": 2,
        "sell_disciple_known": 1,
        "reveal_lean": "+1"
      },
      "goto": "end_1",
      "type": "line"
    },
    "s7_he_blind_1": {
      "id": "s7_he_blind_1",
      "text": "縫開了。阿禾的眼睛在暗裡發亮，不是喜。",
      "sprite": "ahe",
      "goto": "s7_he_blind_2",
      "type": "line"
    },
    "s7_he_blind_2": {
      "id": "s7_he_blind_2",
      "text": "不是沒看見嗎。",
      "speaker": "阿禾",
      "goto": "s7_he_blind_3",
      "type": "line"
    },
    "s7_he_blind_3": {
      "id": "s7_he_blind_3",
      "text": "這句像一記掃帚柄。你站在門外，他沒讓你立刻進。",
      "goto": "s7_he_blind_4",
      "type": "line"
    },
    "s7_he_blind_4": {
      "id": "s7_he_blind_4",
      "text": "劉三有妹妹。這件事，值事房的人都能想起來，沒人敢寫信去鎮裡。你現在來問我，是想當那個寫信的人？還是想確認自己上午裝得夠像？",
      "speaker": "阿禾",
      "goto": "s7_he_blind_5",
      "type": "line"
    },
    "s7_he_blind_5": {
      "id": "s7_he_blind_5",
      "text": "他把門開了一點，只一點。",
      "goto": "s7_he_blind_6",
      "type": "line"
    },
    "s7_he_blind_6": {
      "id": "s7_he_blind_6",
      "text": "箱的事，我上午就該閉嘴。你讓我閉嘴了。謝。",
      "speaker": "阿禾",
      "goto": "s7_he_blind_7",
      "type": "line"
    },
    "s7_he_blind_7": {
      "id": "s7_he_blind_7",
      "text": "謝字咬得很白。他沒把白天的線索給你。他給你的是一扇還願意開的門，和一句：",
      "goto": "s7_he_blind_8",
      "type": "line"
    },
    "s7_he_blind_8": {
      "id": "s7_he_blind_8",
      "text": "明天各掃各的。別並肩。",
      "speaker": "阿禾",
      "goto": "s7_he_blind_9",
      "type": "line"
    },
    "s7_he_blind_9": {
      "id": "s7_he_blind_9",
      "text": "門關上。你站了片刻。短期仍安全。阿禾沒把你當敵人，也沒把你當可以說話的人。夜深了，夾道空著。",
      "sprite": "none",
      "setFlags": {
        "he_distance": 1,
        "safe": "+1"
      },
      "goto": "end_1",
      "type": "line"
    },
    "s7_he_fear_1": {
      "id": "s7_he_fear_1",
      "text": "你敲第一次。沒有聲。",
      "sprite": "none",
      "goto": "s7_he_fear_2",
      "type": "line"
    },
    "s7_he_fear_2": {
      "id": "s7_he_fear_2",
      "text": "第二次。裡頭有人翻身，床板響，隨即死寂。像一具還會呼吸的門規。",
      "goto": "s7_he_fear_3",
      "type": "line"
    },
    "s7_he_fear_3": {
      "id": "s7_he_fear_3",
      "text": "第三次，你聽見他貼著門板，用氣音說：",
      "goto": "s7_he_fear_4",
      "type": "line"
    },
    "s7_he_fear_4": {
      "id": "s7_he_fear_4",
      "text": "不是你。你走。",
      "speaker": "阿禾",
      "goto": "s7_he_fear_5",
      "type": "line"
    },
    "s7_he_fear_5": {
      "id": "s7_he_fear_5",
      "text": "不是否認你是誰。是否認開門這件事本身。你上午讓他少說；他現在用整扇門把「少說」還給你。",
      "goto": "s7_he_fear_6",
      "type": "line"
    },
    "s7_he_fear_6": {
      "id": "s7_he_fear_6",
      "text": "你沒有再敲。再敲，就是把執法堂的耳朵引到這條潮走廊。你退回自己的鋪。夜風從門縫進來，帶著筍乾腐掉的甜。",
      "goto": "s7_he_fear_7",
      "type": "line"
    },
    "s7_he_fear_7": {
      "id": "s7_he_fear_7",
      "text": "阿禾還活著。他只是不當你的人。爬的路今晚清出來了——清在同門這一側。",
      "setFlags": {
        "he_door": 0,
        "he_grudge": 1
      },
      "goto": "end_1",
      "type": "line"
    },
    "s7_xie_1": {
      "id": "s7_xie_1",
      "text": "內門夜禁嚴，外門擅入是記過。可當眾攬過的師兄，側門處常留一盞燈給「有事要報」的人。你賭的就是這一盞。",
      "background": "內門側廊",
      "scene": "請安",
      "goto": [
        {
          "if": {
            "xie_line": 1
          },
          "to": "s7_xie_guided"
        },
        {
          "to": "s7_xie_unguided"
        }
      ],
      "type": "line"
    },
    "s7_xie_guided": {
      "id": "s7_xie_guided",
      "text": "白日並無「掃到側門」的口諭，可夜裡那句已經把路指過了。你沿著那句走。",
      "goto": "s7_xie_2",
      "type": "line"
    },
    "s7_xie_unguided": {
      "id": "s7_xie_unguided",
      "text": "你仍去。燈若在，就是門還開著一條縫。",
      "goto": "s7_xie_2",
      "type": "line"
    },
    "s7_xie_2": {
      "id": "s7_xie_2",
      "text": "燈在。",
      "goto": "s7_xie_3",
      "type": "line"
    },
    "s7_xie_3": {
      "id": "s7_xie_3",
      "text": "一個內門雜役先攔住你，聽你報「謝師兄處請安」，才進去通。謝承淵出來時，已經換了家常的深衣，臉上仍是白日那副溫潤，像從沒進過庫房。",
      "sprite": "xie",
      "goto": "s7_xie_4",
      "type": "line"
    },
    "s7_xie_4": {
      "id": "s7_xie_4",
      "text": "這麼晚。罰站過的人，腿該歇。",
      "speaker": "謝承淵",
      "goto": "s7_xie_5",
      "type": "line"
    },
    "s7_xie_5": {
      "id": "s7_xie_5",
      "text": "你請安。詞是外門教過的那種，低，乾淨。",
      "goto": "s7_xie_6",
      "type": "line"
    },
    "s7_xie_6": {
      "id": "s7_xie_6",
      "text": "陳執法的刀，砍在冊上。冊上有我，你就能少挨一截。今日的記過，我去說。月例……能討回多少是多少。",
      "speaker": "謝承淵",
      "goto": "s7_xie_7",
      "type": "line"
    },
    "s7_xie_7": {
      "id": "s7_xie_7",
      "text": "他沒問你來是求，是謝，還是探。他替你把來意說成求。這很方便。方便的事，日後都要還。",
      "goto": "s7_xie_8",
      "type": "line"
    },
    "s7_xie_8": {
      "id": "s7_xie_8",
      "text": "黃耆的缺，內門自己核。外門的職責是別再傳。傳，就是黨。黨，比缺箱重。",
      "speaker": "謝承淵",
      "goto": "s7_xie_9",
      "type": "line"
    },
    "s7_xie_9": {
      "id": "s7_xie_9",
      "text": "他走到門邊，替你把夜風擋了一擋。",
      "goto": "s7_xie_10",
      "type": "line"
    },
    "s7_xie_10": {
      "id": "s7_xie_10",
      "text": "回去睡。明日側門那兩棵銀杏，葉子多。掃的人，我看得到。",
      "speaker": "謝承淵",
      "goto": "s7_xie_11",
      "type": "line"
    },
    "s7_xie_11": {
      "id": "s7_xie_11",
      "text": "你退下。側廊的燈把你的影子送出內門，送到外門的土階上，影子先沒入暗裡。你沒見到任何功法，沒見到任何不該見的。你只見到一個願意把你的名字從陳肅的筆下輕輕托一托的人。托，是往上。也是離地。",
      "sprite": "none",
      "goto": "s7_xie_12",
      "type": "line"
    },
    "s7_xie_12": {
      "id": "s7_xie_12",
      "text": "夜深了。內門的燈一盞盞滅。你躺回通鋪的時候，腿仍在抖，可抖的原因已經不太像罰站。",
      "background": "外門通舖",
      "setFlags": {
        "xie_hold": 1
      },
      "goto": "end_1",
      "type": "line"
    },
    "end_1": {
      "id": "end_1",
      "text": "夜深。寅時還遠。",
      "background": "外門通舖",
      "sprite": "none",
      "scene": "夜深",
      "goto": "end_2",
      "type": "line"
    },
    "end_2": {
      "id": "end_2",
      "text": "黃耆的空架在庫房裡。劉三的空格在冊上。你的記過在陳肅袖裡那一頁的邊上。鞋裡、枕下、或沒問出口的那句話，各在各的暗處。",
      "goto": "end_3",
      "type": "line"
    },
    "end_3": {
      "id": "end_3",
      "text": "你仍是青衡宗外門的雜役。門規把日子一寸寸削下去，削得合法。揭開的憑據未成章；往上的傘才撐了一角；山門的「除」與「叛」是兩種走法，名帖都不在你手上。",
      "goto": "end_4",
      "type": "line"
    },
    "end_4": {
      "id": "end_4",
      "type": "end",
      "scene": "第一章　終",
      "text": "三條路都還在。今夜只把人送到夜深，不把人送出山門。"
    }
  }
}